# Image and version of every component in the demo, for both the compose and the minikube demo.
#
# Edit a line to pin a component, or override it for one run from the shell:
#   make compose-up GATEWAY_VERSION=0.1.0-rc.3
#   STUDIO_VERSION=edge make k8s-up
# A value set in the shell or on the make command line wins over this file.
#
# kawa tags are published without the git tag's `v` (git v0.1.0-rc.2 -> image 0.1.0-rc.2).
# `make versions` shows what will run and checks that every tag exists.

# A version of `local` builds that component from its source checkout (*_SRC, relative to this
# directory) before make compose-up / make k8s-up, e.g. GATEWAY_VERSION=local for unreleased code.

GATEWAY_IMAGE=ghcr.io/kawa-platform/kawa-gateway
GATEWAY_VERSION=0.1.0-rc.3
GATEWAY_SRC=../kawa-gateway

STUDIO_IMAGE=ghcr.io/kawa-platform/kawa-studio
STUDIO_VERSION=0.1.0-rc.3
STUDIO_SRC=../kawa-studio

OPERATOR_IMAGE=ghcr.io/kawa-platform/kawa-operator
OPERATOR_VERSION=0.1.0-rc.3
# The kawa-operator Helm chart, published with the operator's version. Point it at a local chart
# directory to test unreleased chart changes, e.g. ../kawa-operator/charts/kawa-operator
OPERATOR_CHART=oci://ghcr.io/kawa-platform/charts/kawa-operator

KAFKA_IMAGE=apache/kafka-native
KAFKA_TOOLS_IMAGE=apache/kafka
KAFKA_VERSION=4.3.1

SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry
SCHEMA_REGISTRY_VERSION=8.0.0

# The kawa Helm chart used by the minikube demo (gateway and studio): an OCI/repo reference
# with KAWA_CHART_VERSION, or a local chart directory (KAWA_CHART_VERSION is then ignored), e.g. to test
# unreleased chart changes:
#   make k8s-up KAWA_CHART=../kawa-charts/charts/kawa
KAWA_CHART=oci://ghcr.io/kawa-platform/charts/kawa
KAWA_CHART_VERSION=0.1.0-rc.4
